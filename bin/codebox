#!/usr/bin/env python3
"""codebox: install, update and remove codebox plugins (skills and commands) for coding agents."""
from __future__ import annotations

import json
import os
import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

HARNESSES = ("claude", "codex", "opencode")
HARNESS_DIRS = {"claude": ".claude", "codex": ".codex", "opencode": ".config/opencode"}
OLD_DIRS = (".claude/skills", ".agents/skills", ".local/bin", ".claude/commands", ".config/opencode/skills")


def parse_version(v: str) -> tuple:
    if not isinstance(v, str) or not re.fullmatch(r"\d+\.\d+\.\d+", v):
        raise ValueError(f"bad version {v!r}: expected X.Y.Z")
    return tuple(int(p) for p in v.split("."))


def _check_versions(label: str, version: str, changes: dict) -> None:
    try:
        parse_version(version)
        for k in changes:
            parse_version(k)
    except ValueError as e:
        raise ValueError(f"{label}: {e}")
    if version not in changes:
        raise ValueError(f"{label}: version {version} has no changes entry")


def _frontmatter_name(skill_md: Path):
    m = re.match(r"---\n(.*?)\n---", skill_md.read_text(), re.S)
    n = re.search(r"^name:\s*(\S+)", m.group(1), re.M) if m else None
    return n.group(1) if n else None


def _load_plugin(pdir: Path, root: Path) -> dict:
    name = pdir.name
    manifest = json.loads((pdir / "plugin.json").read_text())
    if manifest.get("name") != name:
        raise ValueError(f"plugin {name}: manifest name {manifest.get('name')!r} differs from folder")
    _check_versions(f"plugin {name}", manifest.get("version"), manifest.get("changes", {}))
    rel = pdir.relative_to(root).as_posix()
    mskills = manifest.get("skills", {})
    sroot = pdir / "skills"
    folders = {d.name for d in sroot.iterdir() if d.is_dir()} if sroot.is_dir() else set()
    for s in sorted(folders - set(mskills)):
        raise ValueError(f"plugin {name}: skill folder {s} is not in the manifest")
    for s in sorted(set(mskills) - folders):
        raise ValueError(f"plugin {name}: manifest skill {s} has no folder")
    skills = {}
    for s, info in sorted(mskills.items()):
        _check_versions(f"skill {s}", info.get("version"), info.get("changes", {}))
        if _frontmatter_name(sroot / s / "SKILL.md") != s:
            raise ValueError(f"skill {s}: SKILL.md name differs from folder")
        skills[s] = {"version": info["version"], "changes": info["changes"], "dir": f"{rel}/skills/{s}"}
    bindir = pdir / "bin"
    commands = {c.name: f"{rel}/bin/{c.name}" for c in sorted(bindir.iterdir()) if c.is_file()} if bindir.is_dir() else {}
    return {"name": name, "version": manifest["version"], "changes": manifest["changes"],
            "dir": rel, "skills": skills, "commands": commands}


def load_plugins(root: Path) -> list:
    proot = Path(root) / "plugins"
    if not proot.is_dir():
        return []
    return [_load_plugin(d, Path(root)) for d in sorted(proot.iterdir()) if (d / "plugin.json").is_file()]


def detect_harnesses(user_home: Path, which=shutil.which) -> list:
    return [h for h in HARNESSES if which(h) or (Path(user_home) / HARNESS_DIRS[h]).exists()]


def desired_links(plugins: list, root: Path, harnesses: list, user_home: Path) -> dict:
    root, home = Path(root), Path(user_home)
    agents = [h for h in ("codex", "opencode") if h in harnesses]
    links = {}
    for p in plugins:
        for s, info in p["skills"].items():
            target = str(root / info["dir"])
            if "claude" in harnesses:
                links[str(home / ".claude/skills" / s)] = {"target": target, "harnesses": ["claude"]}
            if agents:
                links[str(home / ".agents/skills" / s)] = {"target": target, "harnesses": list(agents)}
        for c, rel in p["commands"].items():
            links[str(home / ".local/bin" / c)] = {"target": str(root / rel), "harnesses": []}
    links[str(home / ".local/bin/codebox")] = {"target": str(root / "bin/codebox"), "harnesses": []}
    return links


def is_codebox_tree(path: Path) -> bool:
    p = Path(os.path.realpath(path))
    while not p.is_dir() and p != p.parent:
        p = p.parent
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    r = subprocess.run(["git", "-C", str(p), "remote", "get-url", "origin"], capture_output=True, text=True, env=env)
    return r.returncode == 0 and "codebox" in r.stdout


def classify(dest: Path, recorded: dict) -> str:
    dest = Path(dest)
    if not dest.is_symlink():
        return "foreign" if dest.exists() else "absent"
    if recorded.get(str(dest)) == os.readlink(dest):
        return "ours"
    if not dest.exists():
        return "old" if "codebox" in os.readlink(dest) else "foreign"
    return "old" if is_codebox_tree(dest) else "foreign"


def plan(desired: dict, record, user_home: Path) -> tuple:
    recorded = {l["path"]: l["target"] for l in record["links"]} if record else {}
    creates, conflicts = {}, []
    for dest, d in desired.items():
        kind = classify(Path(dest), recorded)
        if kind == "foreign":
            conflicts.append(dest)
        elif kind == "absent" or os.readlink(dest) != d["target"]:
            creates[dest] = d["target"]
    removes = {p for p in recorded if p not in desired and classify(Path(p), recorded) in ("ours", "old")}
    for d in OLD_DIRS:
        folder = Path(user_home) / d
        for child in sorted(folder.iterdir()) if folder.is_dir() else []:
            if str(child) not in desired and classify(child, recorded) == "old":
                removes.add(str(child))
    return creates, sorted(removes), sorted(conflicts)


def record_path(user_home: Path) -> Path:
    return Path(user_home) / ".local/state/codebox/installed.json"


def read_record(user_home: Path):
    p = record_path(user_home)
    return json.loads(p.read_text()) if p.is_file() else None


def write_record(user_home: Path, rec: dict) -> None:
    p = record_path(user_home)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(p.name + ".tmp")
    tmp.write_text(json.dumps(rec, indent=2) + "\n")
    os.replace(tmp, p)


def codebox_home(env: dict, user_home: Path) -> Path:
    return Path(env["CODEBOX_HOME"]).expanduser().absolute() if env.get("CODEBOX_HOME") else Path(user_home) / ".codebox"


def release_of(root: Path):
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    r = subprocess.run(["git", "-C", str(root), "describe", "--tags", "--exact-match"],
                       capture_output=True, text=True, env=env)
    tag = r.stdout.strip()
    return tag if r.returncode == 0 and re.fullmatch(r"v\d+\.\d+\.\d+", tag) else None


def apply(creates: dict, removes: list) -> None:
    for dest in removes:
        os.unlink(dest)
        print(f"- {dest}")
    for dest, target in sorted(creates.items()):
        Path(dest).parent.mkdir(parents=True, exist_ok=True)
        if os.path.islink(dest):
            os.unlink(dest)
        os.symlink(target, dest)
        print(f"+ {dest} -> {target}")


def install(root: Path, user_home: Path, harness, which=shutil.which) -> int:
    root, user_home = Path(root), Path(user_home)
    rec = read_record(user_home)
    chosen = set(rec["harnesses"]) if rec else set()
    chosen |= {harness} if harness else set(detect_harnesses(user_home, which))
    chosen = [h for h in HARNESSES if h in chosen]
    if not chosen:
        print(f"codebox: no supported harness found (looked for {', '.join(HARNESSES)}); use --harness NAME",
              file=sys.stderr)
        return 1
    skipped = [h for h in HARNESSES if h not in chosen]
    if skipped and not harness:
        print(f"skipped (not found): {', '.join(skipped)}")
    desired = desired_links(load_plugins(root), root, chosen, user_home)
    creates, removes, conflicts = plan(desired, rec, user_home)
    if conflicts:
        print("codebox: nothing changed; these paths exist and weren't created by codebox:", file=sys.stderr)
        for c in conflicts:
            print(f"  {c}", file=sys.stderr)
        return 1
    release = release_of(root)
    apply(creates, removes)
    wired = {h for d in desired.values() for h in d["harnesses"]}
    wired_list = [h for h in HARNESSES if h in wired]
    write_record(user_home, {
        "home": str(root), "release": release, "harnesses": wired_list,
        "links": [{"path": p, "target": d["target"], "harnesses": d["harnesses"]} for p, d in sorted(desired.items())]})
    print(f"codebox installed for {', '.join(wired_list)}")
    bindir = str(user_home / ".local/bin")
    if bindir not in os.environ.get("PATH", "").split(os.pathsep):
        print('add to your shell profile: export PATH="$HOME/.local/bin:$PATH"')
    return 0


def uninstall(user_home: Path) -> int:
    user_home = Path(user_home)
    rec = read_record(user_home)
    if not rec:
        print("codebox: not installed", file=sys.stderr)
        return 1
    for l in rec["links"]:
        p = l["path"]
        if os.path.islink(p) and os.readlink(p) == l["target"]:
            os.unlink(p)
            print(f"- {p}")
        else:
            print(f"left {p} (no longer codebox's link)")
    if rec["home"] == str(user_home / ".codebox"):
        shutil.rmtree(rec["home"], ignore_errors=True)
    else:
        print(f"left {rec['home']} in place")
    record_path(user_home).unlink()
    return 0


def main(argv=None, user_home=None, env=None, which=shutil.which) -> int:
    user_home = Path(user_home) if user_home else Path.home()
    env = os.environ if env is None else env
    ap = argparse.ArgumentParser(prog="codebox", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("install", help="link codebox plugins into your coding agents").add_argument(
        "--harness", choices=HARNESSES, help="wire this harness even if not detected")
    sub.add_parser("uninstall", help="remove codebox's links")
    args = ap.parse_args(argv)
    try:
        if args.cmd == "install":
            return install(codebox_home(env, user_home), user_home, args.harness, which)
        return uninstall(user_home)
    except ValueError as e:
        print(f"codebox: {e}", file=sys.stderr)
    except FileNotFoundError as e:
        if e.filename in (None, "git"):
            print("codebox: needs git", file=sys.stderr)
        else:
            print(f"codebox: {e}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
