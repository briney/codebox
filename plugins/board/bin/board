#!/usr/bin/env python3
"""board: the only thing that talks to GitHub Projects."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from datetime import datetime, timedelta, timezone

STATUSES = ["Triage", "Planned", "In Progress", "Done"]
STATUS_COLORS = {"Triage": "GRAY", "Planned": "BLUE", "In Progress": "YELLOW", "Done": "GREEN"}
STATUS_DESCRIPTIONS = {
    "Triage": "Captured by `codebox-defer`, not yet looked at. The inbox.",
    "Planned": "Decided it's worth doing. Top-to-bottom order = priority.",
    "In Progress": "Work has started (fully or partly).",
    "Done": "Finished.",
}
MARK_START = "<!-- codebox:board:start -->"
MARK_END = "<!-- codebox:board:end -->"


def parse_since(s: str, now: datetime) -> datetime:
    m = re.fullmatch(r"(\d+)([dwh])", s)
    if m:
        unit = {"d": "days", "w": "weeks", "h": "hours"}[m.group(2)]
        return now - timedelta(**{unit: int(m.group(1))})
    try:
        return datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except ValueError:
        raise ValueError("bad --since %r (use 14d, 2w, 36h or YYYY-MM-DD)" % s)


def status_option(name: str) -> str:
    key = re.sub(r"[-_\s]+", " ", name).strip().lower()
    for s in STATUSES:
        if s.lower() == key:
            return s
    raise ValueError("unknown status %r (valid: %s)" % (name, ", ".join(STATUSES)))


def parse_issue_ref(s: str) -> int:
    m = re.fullmatch(r"#?(\d+)|https://github\.com/[^/]+/[^/]+/issues/(\d+)/?", s.strip())
    if not m:
        raise ValueError("bad issue reference %r" % s)
    return int(m.group(1) or m.group(2))


def issue_url_repo(s: str):
    """owner/name from an issue URL, or None for a bare number."""
    m = re.fullmatch(r"https://github\.com/([^/]+/[^/]+)/issues/\d+/?", s.strip())
    return m.group(1) if m else None


def parse_github_remote(url: str):
    """owner/name from a GitHub https or ssh remote URL, or None."""
    m = re.fullmatch(r"(?:https://(?:[^@/]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)"
                     r"([^/\s]+)/([^/\s]+?)(?:\.git)?/?", url.strip())
    return "%s/%s" % m.groups() if m else None


def splice_section(text: str, section: str) -> str:
    i = text.find(MARK_START)
    if i >= 0 and MARK_END not in text[i:]:
        raise ValueError("start marker without end marker")
    block = "%s\n%s\n%s\n" % (MARK_START, section, MARK_END)
    pat = re.compile(re.escape(MARK_START) + r".*?" + re.escape(MARK_END) + r"\n?", re.S)
    if pat.search(text):
        return pat.sub(lambda _: block, text, count=1)
    if not text:
        return block
    return text + ("" if text.endswith("\n") else "\n") + "\n" + block


def claude_pointer(text):
    if text is None:
        return "@AGENTS.md\n"
    if "AGENTS.md" in text:
        return None
    return text + ("" if text.endswith("\n") else "\n") + "@AGENTS.md\n"


def render_list(items: list, repo: str, show_done: bool = False) -> str:
    known = ["Planned", "In Progress", "Triage"]
    custom = []
    for it in items:
        st = it["status"]
        if st and st not in STATUSES and st not in custom and it["state"] != "CLOSED":
            custom.append(st)
    groups = known + custom + ["(no status)"] + (["Done"] if show_done else [])
    buckets = {g: [] for g in groups}
    for it in items:
        if it["state"] == "CLOSED" or it["status"] == "Done":
            g = "Done"
        else:
            g = it["status"] if it["status"] in known + custom else "(no status)"
        if g in buckets:
            ref = "#%d" % it["number"] if it["repo"] == repo else "%s#%d" % (it["repo"], it["number"])
            line = "  %s %s" % (ref, it["title"])
            if it["blocked_by"]:
                line += " [blocked by %s]" % ", ".join(it["blocked_by"])
            buckets[g].append(line)
    return "\n\n".join("%s\n%s" % (g, "\n".join(buckets[g])) for g in groups if buckets[g])


def plan_status_options(existing: list, has_items: bool):
    missing = [s for s in STATUSES if s not in existing]
    if not missing:
        return None
    if not has_items and list(existing) in ([], ["Todo", "In Progress", "Done"]):
        return list(STATUSES)
    raise ValueError("Status field is missing option(s): %s. Add them in the project UI "
                     "(existing options are never rewritten)." % ", ".join(missing))


def die(msg: str):
    print(msg, file=sys.stderr)
    sys.exit(1)


SCOPE_MSG = "Missing project scope. Run: gh auth refresh -h github.com -s project"


def missing_scope(stderr: str, stdout: str) -> bool:
    return ("INSUFFICIENT_SCOPES" in stdout or "INSUFFICIENT_SCOPES" in stderr
            or "project scope" in stderr or "read:project" in stderr or "required scopes" in stderr)


def gh(*args: str, stdin=None) -> str:
    try:
        p = subprocess.run(["gh"] + list(args), input=stdin, capture_output=True, text=True)
    except FileNotFoundError:
        die("gh not found. Install the GitHub CLI: https://cli.github.com")
    if p.returncode != 0:
        err = p.stderr.strip()
        if missing_scope(err, p.stdout):
            die(SCOPE_MSG)
        die(err.splitlines()[-1] if err else "gh %s failed" % " ".join(args[:2]))
    return p.stdout


def graphql(query: str, **variables) -> dict:
    out = gh("api", "graphql", "--input", "-", stdin=json.dumps({"query": query, "variables": variables}))
    res = json.loads(out)
    if res.get("errors"):
        die("; ".join(e.get("message", "?") for e in res["errors"]))
    return res["data"]


def git_toplevel() -> Path:
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if p.returncode != 0:
        die("Not in a git repository.")
    return Path(p.stdout.strip())


def current_repo() -> dict:
    git_toplevel()
    # gh's own default may be `upstream` in a fork; honor an explicit set-default, else use origin.
    p = subprocess.run(["gh", "repo", "set-default", "--view"], capture_output=True, text=True)
    full = p.stdout.strip() if p.returncode == 0 else ""
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", full):
        o = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True)
        full = parse_github_remote(o.stdout) if o.returncode == 0 else None
        if not full:
            die("No GitHub 'origin' remote in this repo.")
    owner, name = full.split("/")
    d = graphql("""query($o:String!,$n:String!){repository(owner:$o,name:$n){id
        owner{id __typename ... on User{databaseId} ... on Organization{databaseId}}}}""",
                o=owner, n=name)["repository"]
    return {"owner": owner, "name": name, "id": d["id"], "owner_id": d["owner"]["id"],
            "owner_type": d["owner"]["__typename"], "owner_db_id": d["owner"]["databaseId"]}


PROJECT_FIELDS = """id number title url
  field(name:"Status"){... on ProjectV2SingleSelectField{id databaseId options{id name}}}"""


def _board(node: dict) -> dict:
    f = node.get("field") or {}
    return {"id": node["id"], "number": node["number"], "title": node["title"], "url": node["url"],
            "status_field_id": f.get("id"), "status_field_db_id": f.get("databaseId"),
            "options": {o["name"]: o["id"] for o in f.get("options", [])}}


def find_board(repo: dict) -> dict:
    full = "%s/%s" % (repo["owner"], repo["name"])
    nodes = graphql("query($o:String!,$n:String!){repository(owner:$o,name:$n){projectsV2(first:20){nodes{%s}}}}"
                    % PROJECT_FIELDS, o=repo["owner"], n=repo["name"])["repository"]["projectsV2"]["nodes"]
    if not nodes:
        die("No board linked to %s. Run board-setup." % full)
    if len(nodes) > 1:
        nodes = [n for n in nodes if n["title"] == repo["name"]] or die(
            "Multiple boards linked to %s: %s" % (full, ", ".join("#%d %s" % (n["number"], n["title"]) for n in nodes)))
        nodes = nodes[:1]
    return _board(nodes[0])


def cmd_find(args) -> int:
    b = find_board(current_repo())
    print("#%d %s %s" % (b["number"], b["title"], b["url"]))
    return 0


def _write_if_changed(path: Path, new: str, label: str):
    old = path.read_text() if path.exists() else None
    if old == new:
        print("%s already up to date" % label)
    else:
        path.write_text(new)
        print("%s %s" % (label, "created" if old is None else "updated"))


def cmd_setup(args) -> int:
    repo = current_repo()
    full = "%s/%s" % (repo["owner"], repo["name"])
    nodes = graphql("query($o:String!,$n:String!){repository(owner:$o,name:$n){projectsV2(first:20){totalCount}}}",
                    o=repo["owner"], n=repo["name"])["repository"]["projectsV2"]["totalCount"]
    if nodes == 0:
        graphql("""mutation($o:ID!,$r:ID!,$t:String!){createProjectV2(input:{ownerId:$o,repositoryId:$r,title:$t}){
            projectV2{id}}}""", o=repo["owner_id"], r=repo["id"], t=repo["name"])
        print("created board %s" % repo["name"])
    b = find_board(repo)
    if nodes:
        print("board #%d %s already exists" % (b["number"], b["title"]))
    if not b["status_field_id"]:
        die("Board #%d has no Status field." % b["number"])
    count = graphql("query($p:ID!){node(id:$p){... on ProjectV2{items{totalCount}}}}", p=b["id"])["node"]["items"]["totalCount"]
    try:
        plan = plan_status_options(list(b["options"]), count > 0)
    except ValueError as e:
        die(str(e))
    if plan is None:
        print("Status options already in place")
    else:
        opts = [{"name": n, "color": STATUS_COLORS[n], "description": STATUS_DESCRIPTIONS[n]} for n in plan]
        graphql("""mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]!){
            updateProjectV2Field(input:{fieldId:$f,singleSelectOptions:$o}){clientMutationId}}""",
                f=b["status_field_id"], o=opts)
        print("set Status options: %s" % ", ".join(plan))
    views = graphql("query($p:ID!){node(id:$p){... on ProjectV2{views(first:20){nodes{layout}}}}}",
                    p=b["id"])["node"]["views"]["nodes"]
    if any(v["layout"] == "BOARD_LAYOUT" for v in views):
        print("Board view already in place")
    else:
        base = "/orgs/%s" % repo["owner"] if repo["owner_type"] == "Organization" else "/user/%d" % repo["owner_db_id"]
        gh("api", "-X", "POST", "%s/projectsV2/%d/views" % (base, b["number"]), "--input", "-",
           stdin=json.dumps({"name": "Board", "layout": "board", "vertical_group_by": [b["status_field_db_id"]]}))
        print("created Board view")
    top = git_toplevel()
    section = (Path(__file__).resolve().parent.parent / "agents-section.md").read_text().rstrip("\n")
    agents = top / "AGENTS.md"
    try:
        spliced = splice_section(agents.read_text() if agents.exists() else "", section)
    except ValueError:
        die("%s has a board start marker but no end marker; fix the markers and re-run." % agents)
    _write_if_changed(agents, spliced, "AGENTS.md")
    claude = top / "CLAUDE.md"
    new = claude_pointer(claude.read_text() if claude.exists() else None)
    if new is None:
        print("CLAUDE.md already points at AGENTS.md")
    else:
        claude.write_text(new)
        print("CLAUDE.md updated")
    return 0


def after_id(ids: list, ref_id: str, before: bool):
    """afterId for updateProjectV2ItemPosition; None means move to the top."""
    i = ids.index(ref_id)
    if not before:
        return ref_id
    return ids[i - 1] if i > 0 else None


def blocker_ref(blocker_repo: str, number: int, repo: str) -> str:
    return "#%d" % number if blocker_repo == repo else "%s#%d" % (blocker_repo, number)


ITEMS_Q = """query($p:ID!,$n:Int!,$c:String){node(id:$p){... on ProjectV2{items(first:$n,after:$c){
  pageInfo{hasNextPage endCursor}
  nodes{id fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name}}
    content{__typename ... on Issue{id number title state stateReason repository{nameWithOwner}
      blockedBy(first:10){nodes{number state repository{nameWithOwner}}}}}}}}}}"""


def board_items(board: dict, repo: str, page_size: int = 100) -> list:
    page_size = int(os.environ.get("BOARD_PAGE_SIZE") or page_size)
    out, cursor = [], None
    while True:
        items = graphql(ITEMS_Q, p=board["id"], n=page_size, c=cursor)["node"]["items"]
        for n in items["nodes"]:
            c = n["content"] or {}
            if c.get("__typename") != "Issue":
                continue
            out.append({
                "item_id": n["id"], "issue_id": c["id"], "number": c["number"], "title": c["title"],
                "state": c["state"], "state_reason": c["stateReason"], "repo": c["repository"]["nameWithOwner"],
                "status": (n["fieldValueByName"] or {}).get("name"),
                "blocked_by": [blocker_ref(b["repository"]["nameWithOwner"], b["number"], repo)
                               for b in c["blockedBy"]["nodes"] if b["state"] == "OPEN"]})
        if not items["pageInfo"]["hasNextPage"]:
            return out
        cursor = items["pageInfo"]["endCursor"]


def ensure_item(board: dict, issue_id: str) -> str:
    return graphql("""mutation($p:ID!,$c:ID!){addProjectV2ItemById(input:{projectId:$p,contentId:$c}){item{id}}}""",
                   p=board["id"], c=issue_id)["addProjectV2ItemById"]["item"]["id"]


def set_status(board: dict, item_id: str, status: str):
    if status not in board["options"]:
        die("Board has no %r option. Add it in the project UI." % status)
    graphql("""mutation($p:ID!,$i:ID!,$f:ID!,$o:String!){updateProjectV2ItemFieldValue(input:{projectId:$p,
        itemId:$i,fieldId:$f,value:{singleSelectOptionId:$o}}){clientMutationId}}""",
            p=board["id"], i=item_id, f=board["status_field_id"], o=board["options"][status])


def get_issue(repo: dict, number: int) -> dict:
    r = graphql("""query($o:String!,$n:String!,$i:Int!){repository(owner:$o,name:$n){issue(number:$i){
        id number title url state projectItems(first:50){nodes{id project{id}}}}}}""",
                o=repo["owner"], n=repo["name"], i=number)["repository"]["issue"]
    if not r:
        die("No issue #%d in %s/%s." % (number, repo["owner"], repo["name"]))
    return r


def issue_item(board: dict, issue: dict):
    for n in issue["projectItems"]["nodes"]:
        if n["project"]["id"] == board["id"]:
            return n["id"]
    return None


def read_text(flag):
    """Text from the flag; `-` reads stdin. Never reads stdin implicitly."""
    if flag == "-":
        return sys.stdin.read().strip()
    return flag or ""


def issue_num(s: str, repo: dict) -> int:
    full = "%s/%s" % (repo["owner"], repo["name"])
    url_repo = issue_url_repo(s)
    if url_repo and url_repo.lower() != full.lower():
        die("%s is not in %s." % (s, full))
    try:
        return parse_issue_ref(s)
    except ValueError as e:
        die(str(e))


def ctx(number: str):
    repo = current_repo()
    board = find_board(repo)
    return repo, board, get_issue(repo, issue_num(number, repo))


def add_comment(issue_id: str, body: str):
    graphql("mutation($i:ID!,$b:String!){addComment(input:{subjectId:$i,body:$b}){clientMutationId}}",
            i=issue_id, b=body)


def close_issue(issue_id: str, reason: str):
    graphql("mutation($i:ID!,$r:IssueClosedStateReason!){closeIssue(input:{issueId:$i,stateReason:$r}){clientMutationId}}",
            i=issue_id, r=reason)


def cmd_add(args) -> int:
    repo = current_repo()
    board = find_board(repo)
    if args.number:
        issue = get_issue(repo, issue_num(args.number, repo))
        if issue_item(board, issue):
            print("#%d already on the board" % issue["number"])
            return 0
    else:
        if not args.title:
            die("add needs --title or an issue number.")
        issue = graphql("""mutation($r:ID!,$t:String!,$b:String!){createIssue(input:{repositoryId:$r,title:$t,body:$b}){
            issue{id number title url}}}""", r=repo["id"], t=args.title, b=read_text(args.body))["createIssue"]["issue"]
    set_status(board, ensure_item(board, issue["id"]), "Triage")
    print("#%d %s %s" % (issue["number"], issue["title"], issue["url"]))
    return 0


def cmd_move(args) -> int:
    try:
        status = status_option(args.status)
    except ValueError as e:
        die(str(e))
    repo, board, issue = ctx(args.number)
    comment = read_text(args.comment)
    if comment:
        add_comment(issue["id"], comment)
    item = issue_item(board, issue) or ensure_item(board, issue["id"])
    if status == "Done":
        if issue["state"] != "CLOSED":
            close_issue(issue["id"], "COMPLETED")
    elif issue["state"] == "CLOSED":
        graphql("mutation($i:ID!){reopenIssue(input:{issueId:$i}){clientMutationId}}", i=issue["id"])
    set_status(board, item, status)
    print("#%d \u2192 %s" % (issue["number"], status))
    return 0


def cmd_order(args) -> int:
    if bool(args.before) == bool(args.after):
        die("order needs exactly one of --before / --after.")
    repo, board, issue = ctx(args.number)
    ref = issue_num(args.before or args.after, repo)
    items = board_items(board, repo="%s/%s" % (repo["owner"], repo["name"]))
    full = "%s/%s" % (repo["owner"], repo["name"])
    m = [i for i in items if i["number"] == ref and i["repo"] == full]
    if not m:
        die("#%d is not on the board." % ref)
    item = issue_item(board, issue) or ensure_item(board, issue["id"])
    ids = [i["item_id"] for i in items if i["item_id"] != item]
    if item == m[0]["item_id"]:
        die("Can't order #%d relative to itself." % ref)
    after = after_id(ids, m[0]["item_id"], bool(args.before))
    graphql("""mutation($p:ID!,$i:ID!,$a:ID){updateProjectV2ItemPosition(input:{projectId:$p,itemId:$i,afterId:$a}){
        clientMutationId}}""", p=board["id"], i=item, a=after)
    print("#%d %s #%d" % (issue["number"], "before" if args.before else "after", ref))
    return 0


def cmd_block(args) -> int:
    repo, board, issue = ctx(args.number)
    blocker = get_issue(repo, issue_num(args.by, repo))
    if not issue_item(board, issue):
        ensure_item(board, issue["id"])
    graphql("""mutation($i:ID!,$b:ID!){addBlockedBy(input:{issueId:$i,blockingIssueId:$b}){clientMutationId}}""",
            i=issue["id"], b=blocker["id"])
    print("#%d blocked by #%d" % (issue["number"], blocker["number"]))
    return 0


def cmd_drop(args) -> int:
    repo, board, issue = ctx(args.number)
    comment = read_text(args.comment)
    if comment:
        add_comment(issue["id"], comment)
    close_issue(issue["id"], "NOT_PLANNED")
    print("#%d dropped" % issue["number"])
    return 0


def cmd_comment(args) -> int:
    repo = current_repo()
    find_board(repo)
    issue = get_issue(repo, issue_num(args.number, repo))
    body = read_text(args.body)
    if not body:
        die("comment needs text (--body TEXT or --body -).")
    add_comment(issue["id"], body)
    print("commented on #%d" % issue["number"])
    return 0


def cmd_search(args) -> int:
    repo = current_repo()
    find_board(repo)
    q = "repo:%s/%s is:issue %s" % (repo["owner"], repo["name"], " ".join(args.terms))
    nodes = graphql("""query($q:String!){search(type:ISSUE,query:$q,first:50){nodes{... on Issue{number title state
        stateReason}}}}""", q=q)["search"]["nodes"]
    for n in nodes:
        st = "open" if n["state"] == "OPEN" else "not planned" if n["stateReason"] == "NOT_PLANNED" else "closed"
        print("#%d [%s] %s" % (n["number"], st, n["title"]))
    return 0


def cmd_list(args) -> int:
    repo = current_repo()
    full = "%s/%s" % (repo["owner"], repo["name"])
    out = render_list(board_items(find_board(repo), repo=full), full, show_done=args.all)
    if out:
        print(out)
    return 0


STAMP_FMT = "%Y-%m-%dT%H:%M:%SZ"


def read_stamp(path: Path):
    try:
        return datetime.strptime(path.read_text().strip(), STAMP_FMT).replace(tzinfo=timezone.utc)
    except (OSError, ValueError):
        return None


def write_stamp(path: Path, now: datetime):
    path.write_text(now.strftime(STAMP_FMT) + "\n")


def section(title: str, lines: list) -> str:
    return "%s\n%s" % (title, "\n".join(lines) if lines else "  (none)")


def fmt_pr(pr: dict, verb: str, when: str) -> list:
    body = (pr["body"] or "").replace("\r\n", "\n").strip()
    return ["  #%d %s (%s %s)" % (pr["number"], pr["title"], verb, when[:10])] + \
        ["    " + l if l.strip() else "" for l in body.splitlines()]


def status_mismatches(items: list, repo: str) -> list:
    """Local cards that are closed but not Done (dropped cards excepted), or open but Done."""
    out = []
    for it in items:
        if it["repo"] != repo:
            continue
        done = it["status"] == "Done"
        st = "status %s" % it["status"] if it["status"] else "no status"
        if it["state"] == "CLOSED" and not done and it.get("state_reason") != "NOT_PLANNED":
            out.append("  #%d %s (closed, %s) -> board move %d done" % (it["number"], it["title"], st, it["number"]))
        elif it["state"] == "OPEN" and done:
            out.append("  #%d %s (open, status Done) -> board move %d in-progress"
                       % (it["number"], it["title"], it["number"]))
    return out


def unboarded(issues: list, items: list, repo: str) -> list:
    on = {i["number"] for i in items if i["repo"] == repo}
    return ["  #%d %s" % (i["number"], i["title"]) for i in issues if i["number"] not in on]


def paged(query: str, conn, **variables) -> list:
    """Every node of a connection; `query` takes $c:String, `conn` picks the connection from the data."""
    out, cursor = [], None
    while True:
        x = conn(graphql(query, c=cursor, **variables))
        out += x["nodes"]
        if not x["pageInfo"]["hasNextPage"]:
            return out
        cursor = x["pageInfo"]["endCursor"]


SEARCH_PR_Q = """query($q:String!,$c:String){search(type:ISSUE,query:$q,first:100,after:$c){
  pageInfo{hasNextPage endCursor} nodes{... on PullRequest{number title body mergedAt updatedAt}}}}"""
OPEN_ISSUES_Q = """query($o:String!,$n:String!,$c:String){repository(owner:$o,name:$n){
  issues(states:OPEN,first:100,after:$c){pageInfo{hasNextPage endCursor} nodes{number title}}}}"""
HISTORY_Q = """query($o:String!,$n:String!,$s:GitTimestamp!,$c:String){repository(owner:$o,name:$n){
  defaultBranchRef{target{... on Commit{history(first:100,since:$s,after:$c){
    pageInfo{hasNextPage endCursor} nodes{oid messageHeadline}}}}}}}"""


def cmd_activity(args) -> int:
    now = datetime.now(timezone.utc).replace(microsecond=0)
    repo = current_repo()
    full = "%s/%s" % (repo["owner"], repo["name"])
    git_dir = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True).stdout.strip()
    stamp = Path(git_dir) / "board-last-activity"
    try:
        since = parse_since(args.since, now) if args.since else read_stamp(stamp) or parse_since("14d", now)
    except ValueError as e:
        die(str(e))
    board = find_board(repo)
    ts = since.strftime(STAMP_FMT)
    o, n = repo["owner"], repo["name"]

    def prs(q):
        return paged(SEARCH_PR_Q, lambda d: d["search"], q="repo:%s is:pr %s" % (full, q))

    merged = [l for pr in prs("is:merged merged:>=" + ts) for l in fmt_pr(pr, "merged", pr["mergedAt"])]
    updated = [l for pr in prs("is:open updated:>=" + ts) for l in fmt_pr(pr, "updated", pr["updatedAt"])]
    branch = graphql("query($o:String!,$n:String!){repository(owner:$o,name:$n){defaultBranchRef{name}}}",
                     o=o, n=n)["repository"]["defaultBranchRef"]
    commits = paged(HISTORY_Q, lambda d: d["repository"]["defaultBranchRef"]["target"]["history"],
                    o=o, n=n, s=ts) if branch else []
    items = board_items(board, repo=full)
    issues = paged(OPEN_ISSUES_Q, lambda d: d["repository"]["issues"], o=o, n=n)
    print("Activity in %s since %s\n" % (full, ts))
    print("\n\n".join([
        section("Merged PRs", merged),
        section("Open PRs updated", updated),
        section("Commits on %s" % (branch or {}).get("name", "(no default branch)"),
                ["  %s %s" % (c["oid"][:7], c["messageHeadline"]) for c in commits]),
        section("Status mismatches", status_mismatches(items, full)),
        section("Open issues not on the board", unboarded(issues, items, full)),
    ]))
    if not args.since:  # an explicit window must not advance the stamp past unseen events
        try:
            write_stamp(stamp, now)
        except OSError as e:
            die("Could not save %s: %s" % (stamp, e.strerror))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="board")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("find", help="print the linked board").set_defaults(fn=cmd_find)
    sub.add_parser("setup", help="create/verify board, statuses, view, AGENTS.md").set_defaults(fn=cmd_setup)
    p = sub.add_parser("add", help="create a card, or put an existing issue on the board")
    p.add_argument("number", nargs="?")
    p.add_argument("--title")
    p.add_argument("--body", help="issue body; `-` reads stdin")
    p.set_defaults(fn=cmd_add)
    p = sub.add_parser("move", help="set a card's status")
    p.add_argument("number")
    p.add_argument("status")
    p.add_argument("--comment", help="comment to post first; `-` reads stdin")
    p.set_defaults(fn=cmd_move)
    p = sub.add_parser("order", help="reposition a card")
    p.add_argument("number")
    p.add_argument("--before")
    p.add_argument("--after")
    p.set_defaults(fn=cmd_order)
    p = sub.add_parser("block", help="mark N as blocked by M")
    p.add_argument("number")
    p.add_argument("--by", required=True)
    p.set_defaults(fn=cmd_block)
    p = sub.add_parser("drop", help="close as not planned")
    p.add_argument("number")
    p.add_argument("--comment", help="comment to post first; `-` reads stdin")
    p.set_defaults(fn=cmd_drop)
    p = sub.add_parser("comment", help="comment on an issue")
    p.add_argument("number")
    p.add_argument("--body", help="comment text; `-` reads stdin")
    p.set_defaults(fn=cmd_comment)
    p = sub.add_parser("search", help="search issues in this repo")
    p.add_argument("terms", nargs="+")
    p.set_defaults(fn=cmd_search)
    p = sub.add_parser("list", help="show the board")
    p.add_argument("--all", action="store_true", help="include Done")
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("activity", help="recent PRs, commits, status mismatches, unboarded issues")
    p.add_argument("--since", help="14d, 2w, 36h or YYYY-MM-DD (default: since the last run, else 14d)")
    p.set_defaults(fn=cmd_activity)
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
